<Window x:Class="CloudInteropOms.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Icon="favicon.ico"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Padding" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <GroupBox Header="Cloud Interop">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Service url" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="UrlBox" />
                <Label Grid.Row="1" Content="Platform id" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PlatformIdBox" />
                <Label Grid.Row="2" Content="Source id" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="SourceIdBox" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                           Text="Sessions on the same platform id share context and intents. The source id names this app to them and must not contain ::." />
                <Label Grid.Row="4" Content="Context group" />
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ContextGroupBox" IsEditable="True" />
                <Label Grid.Row="5" Content="Reconnect attempts" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="RetryLimitBox" Width="80" HorizontalAlignment="Left" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Authentication">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Authenticate with" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AuthModeBox" Width="200" HorizontalAlignment="Left" />
                <Label Grid.Row="1" Content="Username" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="UsernameBox" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Microsoft Entra ID">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Client id" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClientIdBox" />
                <Label Grid.Row="1" Content="Tenant id" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TenantIdBox" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}"
                           Text="Leave empty to let the account used at sign in choose the tenant (organizations)." />
                <Label Grid.Row="3" Content="Authentication id" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="AuthenticationIdBox" />
                <Label Grid.Row="4" Content="Scopes" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ScopesBox" />
                <Label Grid.Row="5" Content="Login hint" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="LoginHintBox" />
                <CheckBox Grid.Row="6" Grid.Column="1" x:Name="UseBrokerCheck" Margin="0,4"
                          Content="Sign in with Windows (WAM) instead of the browser" />
            </Grid>
        </GroupBox>

        <TextBlock x:Name="ErrorText" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
        <TextBlock x:Name="SavedPathText" Style="{StaticResource Hint}" />

        <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Reset to appsettings.json" Click="OnResetClick" Margin="0" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="4,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Save" IsDefault="True" Click="OnSaveClick" FontWeight="SemiBold" />
        </DockPanel>
    </StackPanel>
</Window>
